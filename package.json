{
  "name": "dsh-web-search-custom",
  "version": "2.0.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "description": "给 DSH 的 web_search 换一个自带多源链路的搜索后端：exa / firecrawl / parallel / tinyfish 四条 keyless 端点，加博查 / Tavily / SearXNG / bing 兜底，不再依赖 DeepSeek 官方账号",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "web-search",
    "search-provider",
    "mcp",
    "exa",
    "firecrawl",
    "searxng",
    "bocha"
  ],
  "license": "MIT",
  "author": "XXD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGBound-1229/dsh-web-search-custom.git"
  },
  "bugs": {
    "url": "https://github.com/GGBound-1229/dsh-web-search-custom/issues"
  },
  "homepage": "https://github.com/GGBound-1229/dsh-web-search-custom#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/selftest.mjs",
    "test:chain": "node tests/chain-test.mjs",
    "test:creds": "node tests/selftest-creds.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "自定义网页搜索",
    "description": "用第三方搜索 API / keyless 端点替换 DSH 官方 web_search，不依赖 DeepSeek 账号或 API Key。"
  }
}